#!/bin/bash
green="\e[38;5;82m"
red="\e[38;5;196m"
neutral="\e[0m"
orange="\e[38;5;130m"
blue="\e[38;5;39m"
yellow="\e[38;5;226m"

# ============================================================
# ============ CONFIG — LANGSUNG ISI NILAI ASLI ==============
# ============================================================
BOT_TOKEN="8972465183:AAEUoP3asj3AovUN4jQrHbgiiSW-0rXFgC8"
ADMIN_ID="8166206712"
NAMA_STORE="Z-STORE"
PORT="5888"
DATA_QRIS="00020101021126..."
MERCHANT_ID="M123456"
API_KEY="abcdef123456"
GROUP_CHAT_ID="-1001234567890"
SAWERIA_USERNAME="namasaweria"
SAWERIA_EMAIL="email@gmail.com"
ADMIN_WA="6287861167414"
AUTHX="authxyz123"
GROUP_USERNAME="ZstoreVpn"
# ============================================================

hapus_bot_lama() {
    echo -e "${orange}[1/4] Menghapus bot lama...${neutral}"
    systemctl stop sellvpn.service 2>/dev/null
    systemctl disable sellvpn.service 2>/dev/null
    rm -f /etc/systemd/system/sellvpn.service
    rm -f /usr/bin/sellvpn /usr/bin/server_sellvpn /etc/cron.d/server_sellvpn
    rm -rf /root/CUPU
    if command -v pm2 &> /dev/null; then
        pm2 delete sellvpn &> /dev/null
        pm2 save &> /dev/null
    fi
    systemctl daemon-reload
    echo -e "${green}✅ Bot lama dihapus.${neutral}"
}

pasang_package() {
    echo -e "${blue}[2/4] Install Node.js & dependensi APT...${reset}"
    if ! command -v node >/dev/null 2>&1 || ! node -v | grep -q 'v20'; then
        curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
        apt-get install -y nodejs
    fi
    npm install -g npm@10
    apt update
    apt install -y build-essential libcairo2-dev libpango1.0-dev \
        libjpeg-dev libgif-dev librsvg2-dev pkg-config libpixman-1-dev git curl cron
    echo -e "${green}✅ Dependensi APT selesai.${neutral}"
}

setup_bot() {
    echo -e "${blue}[3/4] Clone repo & install dependencies Node...${reset}"
    timedatectl set-timezone Asia/Jakarta
    if [ ! -d /root/CUPU ]; then
        git clone https://github.com/kcepu877/CUPU.git /root/CUPU
    fi
    cd /root/CUPU
    npm install sqlite3 express crypto telegraf axios dotenv canvas node-fetch form-data
    npm rebuild canvas
    rm -rf node_modules
    npm install
    npm uninstall node-fetch
    npm install node-fetch@2
    chmod +x /root/CUPU/*
    echo -e "${green}✅ Dependencies Node selesai.${neutral}"
}

server_app() {
    clear
    echo -e "${orange}─────────────────────────────────────────${neutral}"
    echo -e "${green}- BOT SELLVPN TELEGRAM MOD BY LITE & Z-STORE${neutral}"
    echo -e "${orange}─────────────────────────────────────────${neutral}"

    # ====== VALIDASI CONFIG ======
    

    echo -e "${blue}[4/4] Menulis .vars.json & setup service...${reset}"

    cat >/root/CUPU/.vars.json <<EOF
{
  "BOT_TOKEN": "$BOT_TOKEN",
  "USER_ID": "$ADMIN_ID",
  "NAMA_STORE": "$NAMA_STORE",
  "PORT": "$PORT",
  "DATA_QRIS": "$DATA_QRIS",
  "MERCHANT_ID": "$MERCHANT_ID",
  "API_KEY": "$API_KEY",
  "GROUP_CHAT_ID": "$GROUP_CHAT_ID",
  "SAWERIA_USERNAME": "$SAWERIA_USERNAME",
  "SAWERIA_EMAIL": "$SAWERIA_EMAIL",
  "ADMIN_WA": "$ADMIN_WA",
  "AUTHX": "$AUTHX",
  "GROUP_USERNAME": "$GROUP_USERNAME"
}
EOF

    echo -e "${green}✅ .vars.json tersimpan di /root/CUPU/.vars.json${neutral}"

    NODE_PATH=$(which node)
    if [ -z "$NODE_PATH" ]; then
        echo -e "${red}❌ Node.js tidak ditemukan.${neutral}"
        exit 1
    fi
    echo -e "${green}✅ Node.js: $NODE_PATH${neutral}"

    cat >/usr/bin/sellvpn <<EOF
#!/bin/bash
cd /root/CUPU || exit 1
$NODE_PATH app.js
EOF
    chmod +x /usr/bin/sellvpn

    cat >/etc/systemd/system/sellvpn.service <<EOF
[Unit]
Description=App Bot sellvpn Service
After=network.target

[Service]
ExecStart=$NODE_PATH /root/CUPU/app.js
WorkingDirectory=/root/CUPU
Restart=always
RestartSec=3
User=root
Environment=NODE_ENV=production
Environment=TZ=Asia/Jakarta
StandardOutput=append:/var/log/sellvpn.log
StandardError=append:/var/log/sellvpn-error.log
LimitNOFILE=10000

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable sellvpn
    systemctl start sellvpn
    service cron restart

    sleep 2

    echo -e "${orange}─────────────────────────────────────────${neutral}"
    echo -e "Status Server: $(systemctl is-active sellvpn)"
    echo -e "${green}✅ Bot berhasil diinstal dan berjalan.${neutral}"
    echo -e "${orange}─────────────────────────────────────────${neutral}"
    echo -e "📋 Log realtime : ${yellow}journalctl -u sellvpn -f${neutral}"
    echo -e "📋 Log file     : ${yellow}tail -f /var/log/sellvpn.log${neutral}"
    echo -e "🔄 Restart      : ${yellow}systemctl restart sellvpn${neutral}"
    echo -e "🛑 Stop         : ${yellow}systemctl stop sellvpn${neutral}"
    echo -e "▶️  Start        : ${yellow}systemctl start sellvpn${neutral}"
    echo -e "📊 Status       : ${yellow}systemctl status sellvpn${neutral}"
    echo -e "${orange}─────────────────────────────────────────${neutral}"
}

# ============================================================
# MAIN
# ============================================================
if [[ $1 == "sellvpn" ]]; then
    hapus_bot_lama
    pasang_package
    setup_bot
    server_app
else
    echo -e "${red}Gunakan: bash start sellvpn${neutral}"
    exit 1
fi
